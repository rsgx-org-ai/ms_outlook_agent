<?xml version="1.0" encoding="UTF-8"?>
<!--
  RSGx Ideas - Outlook add-in manifest (prototype).

  Outlook loads the task pane from the URLs below, so they must be reachable
  without any sign-in. They are hosted on GitHub Pages from this repository:
  https://rsgx-org-ai.github.io/ms_outlook_agent/ (see .github/workflows/pages.yml).
  For local development replace every "https://rsgx-org-ai.github.io/ms_outlook_agent"
  with your dev server, e.g. "https://localhost:3000" (Outlook requires HTTPS -
  see README.md).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>7ca61970-356c-4a7d-b770-b44fb273fb02</Id>
  <Version>0.2.0.0</Version>
  <ProviderName>RSGx Central AI Team</ProviderName>
  <DefaultLocale>en-AU</DefaultLocale>
  <DisplayName DefaultValue="RSGx Ideas"/>
  <Description DefaultValue="Record an idea or note from Outlook"/>
  <IconUrl DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://ai.rsgx.com/"/>

  <AppDomains>
    <AppDomain>https://rsgx-org-ai.github.io</AppDomain>
    <AppDomain>https://ai.rsgx.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Legacy form settings: used only by very old clients that ignore VersionOverrides. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/taskpane.html"/>
        <RequestedHeight>360</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadItem: enough to read the current message's subject and sender for the "Context" line. -->
  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- VersionOverrides 1.0: ribbon button + task pane on read and compose. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="rsgxIdeasReadGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="rsgxIdeasReadButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="rsgxIdeasComposeGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="rsgxIdeasComposeButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="RSGx AI Hub"/>
        <bt:String id="Button.Label" DefaultValue="RSGx Ideas"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Record an idea or note without leaving Outlook."/>
      </bt:LongStrings>
    </Resources>

    <!-- VersionOverrides 1.1: same surface, plus a pinnable task pane on newer clients. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Taskpane.Url"/>

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="rsgxIdeasReadGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="rsgxIdeasReadButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="rsgxIdeasComposeGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="rsgxIdeasComposeButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://rsgx-org-ai.github.io/ms_outlook_agent/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="RSGx AI Hub"/>
          <bt:String id="Button.Label" DefaultValue="RSGx Ideas"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Record an idea or note without leaving Outlook."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
